{"executionPlatform":"Camunda Cloud","executionPlatformVersion":"8.6.0","exporter":{"name":"Camunda Web Modeler","version":"6a0669f"},"schemaVersion":16,"id":"amend-cart-form","type":"default","components":[{"id":"Text_AmendIntro","type":"text","text":"# Amend your cart\nSome items are not available in the quantity you asked for.\n\n{{#loop shortageItems}}\n- **{{productName}}** ({{producerName}}): requested {{requestedQuantity}}, available {{availableQuantity}}\n{{/loop}}\n\nChange the quantities below (set 0 to remove an item), then submit."},{"id":"List_CartItems","type":"dynamiclist","label":"Cart items","path":"cartItems","isRepeating":true,"allowAddRemove":false,"defaultRepetitions":1,"showOutline":true,"components":[{"id":"Field_ProductName","type":"textfield","key":"productName","label":"Product","readonly":true,"layout":{"columns":6}},{"id":"Field_ProducerName","type":"textfield","key":"producerName","label":"Producer","readonly":true,"layout":{"columns":6}},{"id":"Field_Available","type":"number","key":"availableQuantity","label":"Available","readonly":true,"layout":{"columns":6}},{"id":"Field_Quantity","type":"number","key":"quantity","label":"Quantity","description":"Set to 0 to remove the item","validate":{"required":true,"min":0},"layout":{"columns":6}}]}]}