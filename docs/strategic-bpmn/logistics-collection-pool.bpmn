<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Logistics" name="Logistics/Collection" processRef="Process_Logistics" />
  </bpmn:collaboration>
  <bpmn:message id="Message_Basket" name="Basket sent for checkout" />
  <bpmn:message id="Message_Paid" name="Order released to producers" />
  <bpmn:message id="Message_Options" name="Fulfilment options sent to customer" />
  <bpmn:process id="Process_Logistics" isExecutable="false">
    <bpmn:startEvent id="Start_Checkout" name="Basket sent for checkout">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_1" messageRef="Message_Basket" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Task_Identify" name="Identify producers">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Task_Options" name="Offer delivery or collection">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Options" name="Fulfilment options sent to customer">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_3" messageRef="Message_Options" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Checkout" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identify" targetRef="Task_Options" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Options" targetRef="End_Options" />
    <bpmn:startEvent id="Start_Paid" name="Order released to producers">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_2" messageRef="Message_Paid" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Task_Prepare" name="Prepare producer order">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Task_Deliver" name="Deliver or collect order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Start_Paid" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Prepare" targetRef="Task_Deliver" />
    <bpmn:endEvent id="End_Handover" name="Order delivered or collected">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Deliver" targetRef="End_Handover" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>from Marketplace</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2">
      <bpmn:text>to Customer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3">
      <bpmn:text>from Marketplace</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Start_Checkout" targetRef="Note_1" />
    <bpmn:association id="Assoc_2" sourceRef="End_Options" targetRef="Note_2" />
    <bpmn:association id="Assoc_3" sourceRef="Start_Paid" targetRef="Note_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Logistics_di" bpmnElement="Participant_Logistics" isHorizontal="true">
        <dc:Bounds x="140" y="80" width="680" height="430" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Checkout_di" bpmnElement="Start_Checkout">
        <dc:Bounds x="232" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="255" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Identify_di" bpmnElement="Task_Identify" isExpanded="false">
        <dc:Bounds x="340" y="190" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Options_di" bpmnElement="Task_Options" isExpanded="false">
        <dc:Bounds x="520" y="190" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Options_di" bpmnElement="End_Options">
        <dc:Bounds x="720" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="255" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Paid_di" bpmnElement="Start_Paid">
        <dc:Bounds x="232" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="208" y="455" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prepare_di" bpmnElement="Task_Prepare" isExpanded="false">
        <dc:Bounds x="340" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deliver_di" bpmnElement="Task_Deliver" isExpanded="false">
        <dc:Bounds x="520" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Handover_di" bpmnElement="End_Handover">
        <dc:Bounds x="720" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="455" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_1_di" bpmnElement="Note_1">
        <dc:Bounds x="190" y="110" width="120" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_2_di" bpmnElement="Note_2">
        <dc:Bounds x="678" y="110" width="120" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_3_di" bpmnElement="Note_3">
        <dc:Bounds x="190" y="330" width="120" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="230" />
        <di:waypoint x="340" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="460" y="230" />
        <di:waypoint x="520" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="640" y="230" />
        <di:waypoint x="720" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="268" y="430" />
        <di:waypoint x="340" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="460" y="430" />
        <di:waypoint x="520" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="640" y="430" />
        <di:waypoint x="720" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_1_di" bpmnElement="Assoc_1">
        <di:waypoint x="250" y="212" />
        <di:waypoint x="250" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_2_di" bpmnElement="Assoc_2">
        <di:waypoint x="738" y="212" />
        <di:waypoint x="738" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_3_di" bpmnElement="Assoc_3">
        <di:waypoint x="250" y="412" />
        <di:waypoint x="250" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="Task_Identify" />
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="Task_Options" />
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="Task_Prepare" />
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="Task_Deliver" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
