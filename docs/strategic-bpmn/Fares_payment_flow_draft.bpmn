<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_UseCase2" targetNamespace="http://example.com/usecase2/payment" exporter="Camunda Web Modeler" exporterVersion="aa92d9c" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_PaymentRequest" name="PaymentRequest" />
  <bpmn:message id="Message_ServiceRequest" name="ServiceRequest" />
  <bpmn:message id="Message_ServiceResult" name="ServiceResult">
    <bpmn:extensionElements>
      <ns1:subscription xmlns:ns1="http://camunda.org/schema/zeebe/1.0" correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_BookingResult" name="BookingResult">
    <bpmn:extensionElements>
      <ns0:subscription xmlns:ns0="http://camunda.org/schema/zeebe/1.0" correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_UC2">
    <bpmn:participant id="Participant_Customer" name="Customer / Checkout" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Rules" name="Booking / Business Rules" processRef="Process_Rules" />
    <bpmn:participant id="Participant_Service" name="Simulated Payment Service" processRef="Process_Service" />
    <bpmn:messageFlow id="MessageFlow_01" name="Payment request" sourceRef="C_Send" targetRef="R_Start" />
    <bpmn:messageFlow id="MessageFlow_02" name="Payment request" sourceRef="R_Send" targetRef="S_Start" />
    <bpmn:messageFlow id="MessageFlow_03" name="Payment response" sourceRef="S_Send" targetRef="R_Wait" />
    <bpmn:messageFlow id="MessageFlow_04" name="Booking result" sourceRef="R_Notify" targetRef="C_Receive" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Customer / Checkout" isExecutable="true">
    <bpmn:startEvent id="C_Start" name="Start checkout">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_Fare" name="Select fare">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_Review" name="Review fare + 5% commission">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_Method" name="Select payment method">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="C_Send" name="Submit payment request">
      <bpmn:extensionElements>
        <ns1:taskDefinition xmlns:ns1="http://camunda.org/schema/zeebe/1.0" type="checkout-submit-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_Receive" name="Receive booking result" messageRef="Message_BookingResult">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_Gateway" name="Booking confirmed?" default="Flow_08">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="C_Confirmed" name="Booking confirmed">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C_Retry" name="Retry payment?" default="Flow_09">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="C_Abort" name="No confirmed booking">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="C_Start" targetRef="C_Fare" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="C_Fare" targetRef="C_Review" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="C_Review" targetRef="C_Method" />
    <bpmn:sequenceFlow id="Flow_10" name="Yes – change method" sourceRef="C_Retry" targetRef="C_Method">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="C_Method" targetRef="C_Send" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="C_Send" targetRef="C_Receive" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="C_Receive" targetRef="C_Gateway" />
    <bpmn:sequenceFlow id="Flow_07" name="Yes" sourceRef="C_Gateway" targetRef="C_Confirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bookingConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" name="No" sourceRef="C_Gateway" targetRef="C_Retry" />
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="C_Retry" targetRef="C_Abort" />
  </bpmn:process>
  <bpmn:process id="Process_Rules" name="Booking / Business Rules" isExecutable="true">
    <bpmn:startEvent id="R_Start" name="Payment requested">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_R_Start" messageRef="Message_PaymentRequest" />
    </bpmn:startEvent>
    <bpmn:task id="R_Receive" name="Receive request + unique ID">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="R_Send" name="Request payment simulation">
      <bpmn:extensionElements>
        <ns1:taskDefinition xmlns:ns1="http://camunda.org/schema/zeebe/1.0" type="rules-request-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="R_Wait" name="Receive payment response" messageRef="Message_ServiceResult">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="R_Gateway" name="Payment approved?" default="Flow_16">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="R_Confirm" name="Confirm booking">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="R_Decline" name="Keep booking unconfirmed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="R_Notify" name="Notify checkout of outcome">
      <bpmn:extensionElements>
        <ns1:taskDefinition xmlns:ns1="http://camunda.org/schema/zeebe/1.0" type="rules-notify-checkout" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="R_End" name="Done">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="R_Start" targetRef="R_Receive" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="R_Receive" targetRef="R_Send" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="R_Send" targetRef="R_Wait" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="R_Wait" targetRef="R_Gateway" />
    <bpmn:sequenceFlow id="Flow_15" name="Approved" sourceRef="R_Gateway" targetRef="R_Confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="Declined" sourceRef="R_Gateway" targetRef="R_Decline" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="R_Confirm" targetRef="R_Notify" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="R_Decline" targetRef="R_Notify" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="R_Notify" targetRef="R_End" />
  </bpmn:process>
  <bpmn:process id="Process_Service" name="Simulated Payment Service" isExecutable="true">
    <bpmn:startEvent id="S_Start" name="Payment request received">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_S_Start" messageRef="Message_ServiceRequest" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="S_Decide" name="Simulated payment result" default="Flow_22">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Approved" name="Simulate approved (no real charge)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Declined" name="Simulate declined (no real charge)">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="S_Send" name="Send payment response">
      <bpmn:extensionElements>
        <ns1:taskDefinition xmlns:ns1="http://camunda.org/schema/zeebe/1.0" type="simulation-send-response" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_End" name="Response sent">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="S_Start" targetRef="S_Decide" />
    <bpmn:sequenceFlow id="Flow_21" name="Approved" sourceRef="S_Decide" targetRef="S_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=simulateApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="Declined" sourceRef="S_Decide" targetRef="S_Declined" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="S_Approved" targetRef="S_Send" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="S_Declined" targetRef="S_Send" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="S_Send" targetRef="S_End" />
  </bpmn:process>
