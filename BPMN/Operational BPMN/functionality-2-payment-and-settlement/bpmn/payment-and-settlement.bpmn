      <bpmn:messageEventDefinition id="MED_Settle" messageRef="Message_SettlementRequested" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Notify" name="Notify producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0unzk4j</bpmn:incoming>
      <bpmn:outgoing>Flow_16elfqu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1fwho4w" sourceRef="SetStart" targetRef="Task_Calculate_Settlement" />
    <bpmn:endEvent id="Event_030vq3x" name="Settlement Confirmed">
      <bpmn:incoming>Flow_16elfqu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_16elfqu" sourceRef="Notify" targetRef="Event_030vq3x" />
    <bpmn:sequenceFlow id="Flow_0unzk4j" sourceRef="Task_Calculate_Settlement" targetRef="Notify" />
    <bpmn:scriptTask id="Task_Calculate_Settlement" name="Calculate commission and producer dues">
      <bpmn:extensionElements>
        <zeebe:script expression="=for p in producers return {&#10;  producerId: p.producerId,&#10;  commission: round half up( 0.05 * p.itemSubtotal , 0),&#10;  amountDue: p.itemSubtotal - commission + p.deliveryFee&#10;}" resultVariable="allocations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fwho4w</bpmn:incoming>
      <bpmn:outgoing>Flow_0unzk4j</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
