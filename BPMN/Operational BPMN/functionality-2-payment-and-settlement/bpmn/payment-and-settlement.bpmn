<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Payment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:message id="Message_PaymentRequested" name="payment-requested" />
  <bpmn:message id="Message_CustomerRetries" name="customer-retries-payment">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_Payment">
    <bpmn:participant id="Participant_Main" name="Payment" processRef="payment-and-settlement" />
    <bpmn:participant id="Participant_PaymentService" name="Payment Service (gateway)" />
    <bpmn:participant id="Participant_087i48m" name="Customer" processRef="customer-payment" />
    <bpmn:participant id="Participant_Producers" name="Producers" />
    <bpmn:participant id="Participant_1rg7np6" name="Settlement" processRef="Settlement" />
    <bpmn:messageFlow id="MF_Req" name="Payment request" sourceRef="Send" targetRef="Participant_PaymentService" />
    <bpmn:messageFlow id="MF_Resp" name="Payment response" sourceRef="Participant_PaymentService" targetRef="Send" />
    <bpmn:messageFlow id="Flow_1h698aw" sourceRef="CSendDetails" targetRef="Start" />
    <bpmn:messageFlow id="Flow_1lhv8p8" name="Retry Payment" sourceRef="Activity_07p5zi5" targetRef="CDeclined" />
    <bpmn:messageFlow id="Flow_1vqluy3" name="new payment details" sourceRef="Activity_1rlxdb1" targetRef="Event_08l80rf" />
    <bpmn:messageFlow id="MF_Inf" name="Payment failed notice" sourceRef="Activity_170e7dv" targetRef="CFailed" />
    <bpmn:messageFlow id="MF_Rec" name="Receipt" sourceRef="Receipt" targetRef="CReceipt" />
    <bpmn:messageFlow id="Flow_0rsqxzq" sourceRef="Activity_1qkq8i4" targetRef="Event_0qqeqyi" />
    <bpmn:messageFlow id="Flow_04y57ot" sourceRef="CSendRetry" targetRef="MsgRetry" />
    <bpmn:messageFlow id="MF_Prod" name="Producer notification" sourceRef="Notify" targetRef="Participant_Producers" />
    <bpmn:messageFlow id="Flow_1oit1dw" name="Settlement" sourceRef="Event_1ca0udy" targetRef="SetStart" />
  </bpmn:collaboration>
  <bpmn:process id="payment-and-settlement" name="Payment and Settlement" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:sequenceFlow id="Flow_0ktwnpx" sourceRef="Activity_1pqw9il" targetRef="EndCancel" />
    <bpmn:sequenceFlow id="Flow_1aifeth" sourceRef="Hold" targetRef="Activity_1pqw9il" />
    <bpmn:sequenceFlow id="Flow_01gnicg" sourceRef="GwEvt" targetRef="MsgRetry" />
    <bpmn:sequenceFlow id="Flow_1heiqdv" sourceRef="GwEvt" targetRef="Hold" />
    <bpmn:sequenceFlow id="Flow_0341dpl" sourceRef="Activity_0ilcv6z" targetRef="GwEvt" />
    <bpmn:sequenceFlow id="Flow_15093up" name="out of retries" sourceRef="GwRetries" targetRef="Activity_0ilcv6z" />
    <bpmn:sequenceFlow id="Flow_0xzx5ea" name="Retry" sourceRef="GwRetries" targetRef="Wait">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outageRetries &lt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19y2kkn" sourceRef="IncOut" targetRef="GwRetries" />
    <bpmn:sequenceFlow id="Flow_181nudf" sourceRef="Activity_07p5zi5" targetRef="Event_08l80rf" />
    <bpmn:sequenceFlow id="Flow_1lpsbaf" name="attempts &#60; 3" sourceRef="GwAtt" targetRef="Activity_07p5zi5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=attempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AttNo" name="No Attempts left (3 used)" sourceRef="GwAtt" targetRef="SetFailed" />
    <bpmn:sequenceFlow id="F12" sourceRef="IncAtt" targetRef="GwAtt" />
    <bpmn:sequenceFlow id="Flow_0v2is9t" sourceRef="Activity_1qkq8i4" targetRef="Event_0dvsxnp" />
    <bpmn:sequenceFlow id="Flow_11dd59p" sourceRef="Activity_0ech7b5" targetRef="Activity_1qkq8i4" />
    <bpmn:sequenceFlow id="Flow_0rwk6tl" name="Item out of stock" sourceRef="Gateway_0ikljwa" targetRef="Activity_0ech7b5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" name="stock reduced" sourceRef="Gateway_0ikljwa" targetRef="Confirm" />
    <bpmn:sequenceFlow id="F13" sourceRef="SetFailed" targetRef="Activity_170e7dv" />
    <bpmn:sequenceFlow id="Flow_0ns4x24" sourceRef="Activity_170e7dv" targetRef="EndFail" />
    <bpmn:sequenceFlow id="Flow_077x4pu" sourceRef="Receipt" targetRef="Event_1ca0udy" />
    <bpmn:sequenceFlow id="Flow_00o1spn" sourceRef="Confirm" targetRef="Receipt" />
    <bpmn:sequenceFlow id="Flow_10al4u7" sourceRef="Deduct" targetRef="Gateway_0ikljwa" />
    <bpmn:sequenceFlow id="Flow_0h382vs" name="Unavailable" sourceRef="GwRes" targetRef="IncOut" />
    <bpmn:sequenceFlow id="F_Declined" name="Declined" sourceRef="GwRes" targetRef="IncAtt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "DECLINED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Ok" name="Approved" sourceRef="GwRes" targetRef="Deduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="Send" targetRef="GwRes" />
    <bpmn:sequenceFlow id="Flow_1lcvzyt" sourceRef="MsgRetry" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_1yp0hg5" sourceRef="Wait" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_00e398g" sourceRef="Event_08l80rf" targetRef="Send" />
    <bpmn:sequenceFlow id="F5" sourceRef="Init" targetRef="Send" />
    <bpmn:sequenceFlow id="F4" sourceRef="Calc" targetRef="Init" />
    <bpmn:sequenceFlow id="F3" sourceRef="RetPrev" targetRef="EndDup" />
    <bpmn:sequenceFlow id="Flow_0d2uyju" name="No" sourceRef="GwDup" targetRef="Calc" />
    <bpmn:sequenceFlow id="F_DupYes" name="Yes" sourceRef="GwDup" targetRef="RetPrev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alreadyProcessed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="Check" targetRef="GwDup" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Check" />
    <bpmn:serviceTask id="SetFailed" name="PAYMENT FAILED, Keeps basket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-payment-failed" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_AttNo</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="MsgRetry" name="Customer retries within 24 hours">
      <bpmn:incoming>Flow_01gnicg</bpmn:incoming>
      <bpmn:outgoing>Flow_1lcvzyt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Retry24" messageRef="Message_CustomerRetries" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndCancel" name="Order cancelled">
      <bpmn:incoming>Flow_0ktwnpx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Hold" name="24-hour hold expires">
      <bpmn:incoming>Flow_1heiqdv</bpmn:incoming>
      <bpmn:outgoing>Flow_1aifeth</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Hold">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_1pqw9il" name="Set Canceled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-canceled" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1aifeth</bpmn:incoming>
      <bpmn:outgoing>Flow_0ktwnpx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GwEvt">
      <bpmn:incoming>Flow_0341dpl</bpmn:incoming>
      <bpmn:outgoing>Flow_1heiqdv</bpmn:outgoing>
      <bpmn:outgoing>Flow_01gnicg</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:serviceTask id="Activity_0ilcv6z" name="set Payment Pending">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-payment-pending" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15093up</bpmn:incoming>
      <bpmn:outgoing>Flow_0341dpl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Wait" name="Wait 30 seconds">
      <bpmn:incoming>Flow_0xzx5ea</bpmn:incoming>
      <bpmn:outgoing>Flow_1yp0hg5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GwRetries" name="Retries left?" default="Flow_15093up">
      <bpmn:incoming>Flow_19y2kkn</bpmn:incoming>
      <bpmn:outgoing>Flow_0xzx5ea</bpmn:outgoing>
      <bpmn:outgoing>Flow_15093up</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IncOut" name="Increase outage retries">
      <bpmn:extensionElements>
        <zeebe:script expression="=outageRetries + 1" resultVariable="outageRetries" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0h382vs</bpmn:incoming>
      <bpmn:outgoing>Flow_19y2kkn</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Event_08l80rf" name="New Payment info received">
      <bpmn:incoming>Flow_181nudf</bpmn:incoming>
      <bpmn:outgoing>Flow_00e398g</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0q50ra9" messageRef="Message_0dl15u6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Activity_07p5zi5" name="Inform Customer to Retry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform-customer-retry" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lpsbaf</bpmn:incoming>
      <bpmn:outgoing>Flow_181nudf</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GwAtt" name="Attempts left?" default="F_AttNo">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F_AttNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_1lpsbaf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IncAtt" name="Increase attempts">
      <bpmn:extensionElements>
        <zeebe:script expression="=attempts + 1" resultVariable="attempts" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Declined</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0dvsxnp" name="order stopped">
      <bpmn:incoming>Flow_0v2is9t</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_1qkq8i4" name="Inform Customer item unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform-item-unavailable" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11dd59p</bpmn:incoming>
      <bpmn:outgoing>Flow_0v2is9t</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Activity_0ech7b5" name="Void Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="void-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rwk6tl</bpmn:incoming>
      <bpmn:outgoing>Flow_11dd59p</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Confirm" name="Mark order CONFIRMED">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-order-confirmed" />
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>Flow_00o1spn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0ikljwa" name="Stock reduced?" default="F7">
      <bpmn:incoming>Flow_10al4u7</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rwk6tl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_170e7dv" name="inform customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform-payment-failed" />
      </bpmn:extensionElements>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>Flow_0ns4x24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndFail" name="Payment failed">
      <bpmn:incoming>Flow_0ns4x24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1ca0udy" name="Order confirmed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-settlement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_077x4pu</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_03uq3kj" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Receipt" name="Send receipt to Customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issue-receipt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00o1spn</bpmn:incoming>
      <bpmn:outgoing>Flow_077x4pu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Deduct" name="Deduct stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="deduct-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Ok</bpmn:incoming>
      <bpmn:outgoing>Flow_10al4u7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwRes" name="Payment result" default="Flow_0h382vs">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F_Ok</bpmn:outgoing>
      <bpmn:outgoing>F_Declined</bpmn:outgoing>
      <bpmn:outgoing>Flow_0h382vs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Send" name="Send payment request to gateway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-payment-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>Flow_00e398g</bpmn:incoming>
      <bpmn:incoming>Flow_1yp0hg5</bpmn:incoming>
      <bpmn:incoming>Flow_1lcvzyt</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Init" name="Initialise payment  attempts and outage retries">
      <bpmn:extensionElements>
        <zeebe:script expression="={ attempts: 0, outageRetries: 0 }" resultVariable="counters" />
        <zeebe:ioMapping>
          <zeebe:output source="=counters.attempts" target="attempts" />
          <zeebe:output source="=counters.outageRetries" target="outageRetries" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Calc" name="Calculate subtotal">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  itemSubtotal: sum(for p in producers return p.itemSubtotal),&#10;  deliveryTotal: sum(for p in producers return p.deliveryFee),&#10;  customerTotal: sum(for p in producers return p.itemSubtotal + p.deliveryFee)&#10;}" resultVariable="amounts" />
        <zeebe:ioMapping>
          <zeebe:output source="=amounts.itemSubtotal" target="itemSubtotal" />
          <zeebe:output source="=amounts.deliveryTotal" target="deliveryTotal" />
          <zeebe:output source="=amounts.customerTotal" target="customerTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d2uyju</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndDup" name="Duplicate ignored">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="RetPrev" name="Return previous result">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-previous-result" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_DupYes</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwDup" name="Already processed?" default="Flow_0d2uyju">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_DupYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_0d2uyju</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Check" name="Check order reference">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-order-reference" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start" name="Payment requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" messageRef="Message_PaymentRequested" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="customer-payment" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0gf09te" sourceRef="CStart2" targetRef="CSendRetry" />
    <bpmn:sequenceFlow id="Flow_065lok7" sourceRef="CSendRetry" targetRef="Gateway_0rilflq" />
    <bpmn:sequenceFlow id="Flow_0bbkjcg" sourceRef="Event_0qqeqyi" targetRef="Event_0xd08po" />
    <bpmn:sequenceFlow id="Flow_18c5qyt" sourceRef="Gateway_0rilflq" targetRef="Event_0qqeqyi" />
    <bpmn:sequenceFlow id="Flow_0czzexs" sourceRef="Gateway_0rilflq" targetRef="CFailed" />
    <bpmn:sequenceFlow id="C6" sourceRef="CFailed" targetRef="CEndFail" />
    <bpmn:sequenceFlow id="C4" sourceRef="CReceipt" targetRef="CEndOk" />
    <bpmn:sequenceFlow id="Flow_078avrq" sourceRef="Gateway_0rilflq" targetRef="CReceipt" />
    <bpmn:sequenceFlow id="Flow_0b2x2ei" sourceRef="Gateway_0rilflq" targetRef="CDeclined" />
    <bpmn:sequenceFlow id="Flow_10gk6f6" sourceRef="CSendDetails" targetRef="Gateway_0rilflq" />
    <bpmn:sequenceFlow id="Flow_1mbfp1v" sourceRef="Event_065i3bn" targetRef="CSendDetails" />
    <bpmn:sequenceFlow id="Flow_0rq4kal" sourceRef="Activity_1rlxdb1" targetRef="Gateway_0rilflq" />
    <bpmn:sequenceFlow id="Flow_0ixgcbe" sourceRef="CRetry" targetRef="Activity_1rlxdb1" />
    <bpmn:sequenceFlow id="Flow_1b4p5e6" sourceRef="CDeclined" targetRef="CRetry" />
    <bpmn:startEvent id="Event_065i3bn" name="Customer submits payment detail">
      <bpmn:outgoing>Flow_1mbfp1v</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="CStart2" name="Customer returns to retry">
      <bpmn:outgoing>Flow_0gf09te</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CStart2" messageRef="Message_CustomerReturns" />
    </bpmn:startEvent>
    <bpmn:sendTask id="CSendRetry" name="Send retry request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-retry-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gf09te</bpmn:incoming>
      <bpmn:outgoing>Flow_065lok7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_0rilflq">
      <bpmn:incoming>Flow_10gk6f6</bpmn:incoming>
      <bpmn:incoming>Flow_065lok7</bpmn:incoming>
      <bpmn:incoming>Flow_0rq4kal</bpmn:incoming>
      <bpmn:outgoing>Flow_18c5qyt</bpmn:outgoing>
      <bpmn:outgoing>Flow_0b2x2ei</bpmn:outgoing>
      <bpmn:outgoing>Flow_078avrq</bpmn:outgoing>
      <bpmn:outgoing>Flow_0czzexs</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:endEvent id="Event_0xd08po" name="Back to checkout">
      <bpmn:incoming>Flow_0bbkjcg</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_0qqeqyi" name="item unavailable  message recieved">
      <bpmn:incoming>Flow_18c5qyt</bpmn:incoming>
      <bpmn:outgoing>Flow_0bbkjcg</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1wz6eks" messageRef="Message_09imh9j" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CFailed" name="Payment failed message received">
      <bpmn:incoming>Flow_0czzexs</bpmn:incoming>
      <bpmn:outgoing>C6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CFail" messageRef="Message_FailedNotice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="CEndFail" name="Payment failed">
      <bpmn:incoming>C6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CEndOk" name="Payment complete">
