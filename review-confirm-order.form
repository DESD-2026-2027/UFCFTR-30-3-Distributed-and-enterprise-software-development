{"executionPlatform":"Camunda Cloud","executionPlatformVersion":"8.6.0","exporter":{"name":"Camunda Web Modeler","version":"6a0669f"},"schemaVersion":16,"id":"review-confirm-order-form","type":"default","components":[{"id":"Text_ReviewSummary","type":"text","text":"# Review your order\nOrder reference: **{{orderRef}}**\n\nYour basket has been split into one order per producer:\n\n{{#loop producerOrders}}\n### {{producerName}}\n- Fulfilment: {{fulfilmentMethod}}\n- Products subtotal: £{{itemsPrice}}\n- Delivery fee: £{{deliveryPrice}}\n- **Producer total: £{{subtotal}}**\n{{/loop}}\n\n---\n- **Products total:** £{{itemsTotal}}\n- **Delivery total:** £{{deliveryTotal}}\n- **Grand total: £{{orderTotal}}**"},{"id":"Field_OrderConfirmed","type":"checkbox","key":"orderConfirmed","label":"I have reviewed this order and confirm it","validate":{"required":true}}]}