{"executionPlatform":"Camunda Cloud","executionPlatformVersion":"8.6.0","exporter":{"name":"Camunda Web Modeler","version":"6a0669f"},"schemaVersion":16,"id":"fulfilment-choice-form","type":"default","components":[{"id":"Text_ChoiceIntro","type":"text","text":"# Delivery or collection\nThe producers below offer both delivery and collection. Choose one for each."},{"id":"List_Producers","type":"dynamiclist","label":"Producers","path":"fulfilmentOptions","isRepeating":true,"allowAddRemove":false,"defaultRepetitions":1,"showOutline":true,"components":[{"id":"Field_ChoiceProducer","type":"textfield","key":"producerName","label":"Producer","readonly":true},{"id":"Field_FulfilmentMethod","type":"radio","key":"fulfilmentMethod","label":"Delivery or collection","values":[{"label":"Delivery","value":"DELIVERY"},{"label":"Collection","value":"COLLECTION"}],"validate":{"required":true},"conditional":{"hide":"=not(this.offersDelivery = true and this.offersCollection = true)"}}]}]}