    <bpmn:sendTask id="Activity_1po4dxd" name="Submit basket for checkout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cust-submitbasket" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
          <zeebe:input source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jq3t6q</bpmn:incoming>
      <bpmn:outgoing>Flow_00thkzd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="StartEvent_1" name="Customer decides to checkout">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(orderRef) and orderRef != &#34;&#34; then orderRef else &#34;ORD-&#34; + string(floor(random number() * 900000) + 100000)" target="orderRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0jq3t6q</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_07g0vit" sourceRef="Gateway_13ocfup" targetRef="Catch_Cust_OptionsTimeout" />
    <bpmn:sequenceFlow id="Flow_1ofde9m" sourceRef="Catch_Cust_OptionsTimeout" targetRef="End_Cust_OptionsTimeout" />
