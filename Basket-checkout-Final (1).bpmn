    <bpmn:sequenceFlow id="Flow_1ck4svm" sourceRef="Gateway_05baqsa" targetRef="Activity_02otoo8" />
    <bpmn:serviceTask id="Activity_02otoo8" name="Create order per producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-createproducerorder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ck4svm</bpmn:incoming>
      <bpmn:outgoing>Flow_0j9fzo5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=fulfilmentOptions" inputElement="producer" outputCollection="producerOrders" outputElement="=producerOrder" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0j9fzo5" sourceRef="Activity_02otoo8" targetRef="Activity_1fvlqhg" />
    <bpmn:sequenceFlow id="Flow_1ooiyut" sourceRef="Gateway_15s4arq" targetRef="Activity_1jmv9tv" />
    <bpmn:sendTask id="Activity_1jmv9tv" name="Notify customer of checkout timeout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-notifytimeout" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ooiyut</bpmn:incoming>
      <bpmn:outgoing>Flow_0473hoi</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_1fvlqhg" name="Send order summary for review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-sendsummary" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(producerOrders) then producerOrders else []" target="producerOrders" />
          <zeebe:input source="=if is defined(orderTotal) then orderTotal else sum(for p in (if is defined(producerOrders) then producerOrders else []) return (if is defined(p.itemSubtotal) then p.itemSubtotal else 0) + (if is defined(p.deliveryFee) then p.deliveryFee else 0))" target="orderTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0j9fzo5</bpmn:incoming>
      <bpmn:outgoing>Flow_1jge0uo</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_1jge0uo" sourceRef="Activity_1fvlqhg" targetRef="Gateway_0fb6nmu" />
    <bpmn:eventBasedGateway id="Gateway_0fb6nmu" name="Await order confirmation">
      <bpmn:incoming>Flow_1jge0uo</bpmn:incoming>
      <bpmn:outgoing>Flow_0kngzt3</bpmn:outgoing>
      <bpmn:outgoing>Flow_13qoeeu</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_0kngzt3" sourceRef="Gateway_0fb6nmu" targetRef="Event_0hyp5os" />
    <bpmn:intermediateCatchEvent id="Event_0hyp5os" name="Confirmation timeout">
      <bpmn:incoming>Flow_0kngzt3</bpmn:incoming>
      <bpmn:outgoing>Flow_0xtvl4c</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_19xvzsf">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0xtvl4c" sourceRef="Event_0hyp5os" targetRef="Gateway_15s4arq" />
    <bpmn:endEvent id="Event_1ffcb42" name="Checkout abandoned - timeout">
      <bpmn:incoming>Flow_0473hoi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0473hoi" sourceRef="Activity_1jmv9tv" targetRef="Event_1ffcb42" />
    <bpmn:intermediateCatchEvent id="Event_1teav3h" name="Order confirmation received">
      <bpmn:incoming>Flow_13qoeeu</bpmn:incoming>
      <bpmn:outgoing>Flow_1397t0z</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_123stdk" messageRef="Message_1b83n3i" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_13qoeeu" sourceRef="Gateway_0fb6nmu" targetRef="Event_1teav3h" />
    <bpmn:sequenceFlow id="Flow_1397t0z" sourceRef="Event_1teav3h" targetRef="Activity_04qtz5g" />
    <bpmn:sendTask id="Activity_04qtz5g" name="Send payment-requested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-paymentrequested" />
        <zeebe:ioMapping>
          <zeebe:input source="=if is defined(orderRef) then orderRef else &#34;ORD-001&#34;" target="orderRef" />
          <zeebe:input source="=if is defined(producerOrders) then (for p in producerOrders return {producerId: p.producerId, itemSubtotal: p.itemSubtotal, deliveryFee: p.deliveryFee}) else []" target="producers" />
          <zeebe:input source="=if is defined(cartItems) then cartItems else []" target="items" />
          <zeebe:input source="=if is defined(producerOrders) and count(producerOrders) &#62; 0 then sum(for p in producerOrders return (if is defined(p.deliveryFee) then p.deliveryFee else 0)) else (if is defined(deliveryFee) then deliveryFee else 0)" target="deliveryFee" />
          <zeebe:input source="=if is defined(orderTotal) then orderTotal else sum(for p in (if is defined(producerOrders) then producerOrders else []) return (if is defined(p.itemSubtotal) then p.itemSubtotal else 0) + (if is defined(p.deliveryFee) then p.deliveryFee else 0))" target="orderTotal" />
          <zeebe:input source="=if is defined(commissionRate) then commissionRate else 0.05" target="commissionRate" />
          <zeebe:input source="=if is defined(customerId) then customerId else null" target="customerId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1397t0z</bpmn:incoming>
      <bpmn:outgoing>Flow_04pxu7r</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_17c5sjv" name="Payment requested - handed to Functionality 2">
      <bpmn:incoming>Flow_04pxu7r</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04pxu7r" sourceRef="Activity_04qtz5g" targetRef="Event_17c5sjv" />
  </bpmn:process>
