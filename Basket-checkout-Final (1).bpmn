  </bpmn:collaboration>
  <bpmn:process id="Process_078f3ih" name="Customer Process" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0jq3t6q" sourceRef="StartEvent_1" targetRef="Activity_1po4dxd" />
    <bpmn:sequenceFlow id="Flow_00thkzd" sourceRef="Activity_1po4dxd" targetRef="Gateway_1fvjlhq" />
