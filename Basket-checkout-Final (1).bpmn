    <bpmn:sequenceFlow id="Flow_060ajn5" sourceRef="Activity_1wxxtu9" targetRef="End_Cust_Confirmed" />
    <bpmn:sendTask id="Activity_1iotub3" name="Submit delivery or collection choice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cust-submitchoice" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16e2f80</bpmn:incoming>
      <bpmn:outgoing>Flow_1nbfhwb</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_0wdccu0" name="Select delivery or collection">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="fulfilment-choice-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09iwxqh</bpmn:incoming>
      <bpmn:outgoing>Flow_16e2f80</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_Cust_ChoiceRequest" name="Delivery or collection choice requested">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i0shms</bpmn:incoming>
      <bpmn:outgoing>Flow_09iwxqh</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C_ChoiceReq" messageRef="Msg_Choice_Request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Cust_OptionsTimeout" name="Checkout timeout notification received">
      <bpmn:incoming>Flow_07g0vit</bpmn:incoming>
      <bpmn:outgoing>Flow_1ofde9m</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C_OptTimeout" messageRef="Msg_Cust_Timeout" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Cust_OptionsTimeout" name="Checkout aborted - timeout">
      <bpmn:incoming>Flow_1ofde9m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_1b538ry" name="Submit amended cart">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cust-submitamendedcart" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03uq1ny</bpmn:incoming>
      <bpmn:outgoing>Flow_05qw5jw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_0hsk9tx" name="Amend cart">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="amend-cart-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ee96v3</bpmn:incoming>
      <bpmn:outgoing>Flow_03uq1ny</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_19iqthn" name="Stock shortage notified">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
          <zeebe:output source="=if is defined(shortageItems) then shortageItems else []" target="shortageItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vqzsqj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ee96v3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1sbpddu" messageRef="Message_0stksht" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Cust_Confirmed" name="Order confirmed - proceeding to payment">
      <bpmn:incoming>Flow_060ajn5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_1wxxtu9" name="Send order confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cust-confirmorder" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1gxxexa</bpmn:incoming>
      <bpmn:outgoing>Flow_060ajn5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_08g6kv2" name="Review and confirm order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-confirm-order-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1soshgk</bpmn:incoming>
      <bpmn:outgoing>Flow_1gxxexa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_Cust_ReviewSummary" name="Order summary received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(producerOrders) then producerOrders else []" target="producerOrders" />
          <zeebe:output source="=if is defined(itemsTotal) then itemsTotal else &#34;0.00&#34;" target="itemsTotal" />
          <zeebe:output source="=if is defined(deliveryTotal) then deliveryTotal else &#34;0.00&#34;" target="deliveryTotal" />
          <zeebe:output source="=if is defined(orderTotal) then orderTotal else &#34;0.00&#34;" target="orderTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1cu8t2f</bpmn:incoming>
      <bpmn:outgoing>Flow_1soshgk</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C_Summary" messageRef="Msg_Order_Summary" />
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:message id="Message_0stksht" name="Stock shortage notified">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Cust_Timeout" name="Checkout timeout notification">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Choice_Request" name="Delivery or collection choice requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Order_Summary" name="Order summary ready for review">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process_0e7opzs" name="Marketplace Process" isExecutable="true">
    <bpmn:startEvent id="Event_1kgrb3p" name="Basket submitted for checkout">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
          <zeebe:output source="=if is defined(deliveryFee) then deliveryFee else 0" target="deliveryFee" />
          <zeebe:output source="=if is defined(commissionRate) then commissionRate else 0.05" target="commissionRate" />
          <zeebe:output source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
          <zeebe:output source="=if is defined(orderRef) and orderRef != null then orderRef else &#34;&#34;" target="orderRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_15o1f61</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0bl6hhj" messageRef="Message_0lh5yc4" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_15o1f61" sourceRef="Event_1kgrb3p" targetRef="Activity_0flbx5k" />
    <bpmn:scriptTask id="Activity_0flbx5k" name="Generate unique orderRef">
      <bpmn:extensionElements>
        <zeebe:script expression="=if is defined(orderRef) and orderRef != &#34;&#34; then orderRef else &#34;ORD-&#34; + string(floor(random number() * 900000) + 100000)" resultVariable="orderRef" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15o1f61</bpmn:incoming>
      <bpmn:outgoing>Flow_0o6pjw4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_16cnvkl">
      <bpmn:incoming>Flow_0o6pjw4</bpmn:incoming>
      <bpmn:incoming>Flow_1symq9t</bpmn:incoming>
      <bpmn:outgoing>Flow_0npliau</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0o6pjw4" sourceRef="Activity_0flbx5k" targetRef="Gateway_16cnvkl" />
    <bpmn:sequenceFlow id="Flow_0npliau" sourceRef="Gateway_16cnvkl" targetRef="Activity_0ltbqzc" />
    <bpmn:serviceTask id="Activity_0ltbqzc" name="Check stock availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-checkstock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0npliau</bpmn:incoming>
      <bpmn:outgoing>Flow_0wo2qjh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0wo2qjh" sourceRef="Activity_0ltbqzc" targetRef="Gateway_0jnzon5" />
    <bpmn:exclusiveGateway id="Gateway_0jnzon5" name="Stock available?" default="Flow_1huizue">
      <bpmn:incoming>Flow_0wo2qjh</bpmn:incoming>
      <bpmn:outgoing>Flow_1huizue</bpmn:outgoing>
      <bpmn:outgoing>Flow_1t37zdx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1huizue" name="Insufficient" sourceRef="Gateway_0jnzon5" targetRef="Activity_08a5mis" />
    <bpmn:sendTask id="Activity_08a5mis" name="Notify customer of stock shortage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-notifyshortage" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
          <zeebe:input source="=if is defined(shortageItems) then shortageItems else []" target="shortageItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1huizue</bpmn:incoming>
      <bpmn:outgoing>Flow_02roqss</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_02roqss" sourceRef="Activity_08a5mis" targetRef="Gateway_1urvqvd" />
    <bpmn:intermediateCatchEvent id="Event_1rz5idz" name="Amended cart received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(cartItems) then cartItems else []" target="cartItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04mx4qf</bpmn:incoming>
      <bpmn:outgoing>Flow_1symq9t</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_167omow" messageRef="Message_1lw69hm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_04mx4qf" sourceRef="Gateway_1urvqvd" targetRef="Event_1rz5idz" />
    <bpmn:sequenceFlow id="Flow_1symq9t" name="Re-check stock" sourceRef="Event_1rz5idz" targetRef="Gateway_16cnvkl" />
    <bpmn:intermediateCatchEvent id="Event_1sdqwvi" name="Cart amendment timeout">
      <bpmn:incoming>Flow_0fq4ts8</bpmn:incoming>
      <bpmn:outgoing>Flow_0001c1g</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_04zzc56">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0fq4ts8" sourceRef="Gateway_1urvqvd" targetRef="Event_1sdqwvi" />
    <bpmn:sequenceFlow id="Flow_1t37zdx" name="All available" sourceRef="Gateway_0jnzon5" targetRef="Gateway_0sca150">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "ALL_AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0sca150" name="Any producer offers both delivery and collection?" default="Flow_1lfjgty">
      <bpmn:incoming>Flow_1t37zdx</bpmn:incoming>
      <bpmn:outgoing>Flow_1b4n8vd</bpmn:outgoing>
      <bpmn:outgoing>Flow_1lfjgty</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_1urvqvd" name="Await amended cart">
      <bpmn:incoming>Flow_02roqss</bpmn:incoming>
      <bpmn:outgoing>Flow_04mx4qf</bpmn:outgoing>
      <bpmn:outgoing>Flow_0fq4ts8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_1b4n8vd" name="Yes" sourceRef="Gateway_0sca150" targetRef="Activity_0hgo6c2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some option in fulfilmentOptions satisfies (option.offersDelivery = true and option.offersCollection = true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="Activity_0hgo6c2" name="Request delivery or collection choice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="market-requestchoice" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderRef" target="orderRef" />
          <zeebe:input source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1b4n8vd</bpmn:incoming>
      <bpmn:outgoing>Flow_08lovw5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_0i4o43z" name="Await fulfilment choice">
      <bpmn:incoming>Flow_08lovw5</bpmn:incoming>
      <bpmn:outgoing>Flow_1mkve5e</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ulgc3g</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_08lovw5" sourceRef="Activity_0hgo6c2" targetRef="Gateway_0i4o43z" />
    <bpmn:intermediateCatchEvent id="Event_0yhtaxv" name="Delivery or collection choice received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(fulfilmentOptions) then fulfilmentOptions else []" target="fulfilmentOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mkve5e</bpmn:incoming>
      <bpmn:outgoing>Flow_1c2q5x9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1gcldv3" messageRef="Message_05kcqfe" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1mkve5e" sourceRef="Gateway_0i4o43z" targetRef="Event_0yhtaxv" />
    <bpmn:sequenceFlow id="Flow_1c2q5x9" sourceRef="Event_0yhtaxv" targetRef="Gateway_05baqsa" />
    <bpmn:exclusiveGateway id="Gateway_05baqsa">
      <bpmn:incoming>Flow_1c2q5x9</bpmn:incoming>
      <bpmn:incoming>Flow_1lfjgty</bpmn:incoming>
      <bpmn:outgoing>Flow_1ck4svm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1lfjgty" name="No" sourceRef="Gateway_0sca150" targetRef="Gateway_05baqsa" />
    <bpmn:sequenceFlow id="Flow_0ulgc3g" sourceRef="Gateway_0i4o43z" targetRef="Event_161t16h" />
    <bpmn:intermediateCatchEvent id="Event_161t16h" name="Fulfilment choice timeout">
      <bpmn:incoming>Flow_0ulgc3g</bpmn:incoming>
      <bpmn:outgoing>Flow_03hs34a</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0v6tc3q">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_03hs34a" sourceRef="Event_161t16h" targetRef="Gateway_15s4arq" />
    <bpmn:exclusiveGateway id="Gateway_15s4arq">
      <bpmn:incoming>Flow_03hs34a</bpmn:incoming>
      <bpmn:incoming>Flow_0001c1g</bpmn:incoming>
